{
  "scenario_id": "S-001",
  "version": 1,
  "title": "Building 822: warm, muggy halls",
  "building": "barracks822",
  "complaint": "Front desk, start of shift: \"The halls on every floor have been warm and muggy since this morning. The room units are blowing, but the air isn't cold.\"",
  "safety_banner": "Safety steps in this case are simulated decisions for training, not procedures. Real isolation, lockout/tagout, and electrical work follow your employer's training and site rules.",
  "max_wait_min": 60,
  "stabilization_window_min": 20,
  "supply_band_f": 2.0,
  "local_display_prefixes": ["RTAC822_"],
  "actions": [
    {"action_id": "pin_point", "label": "Record a BAS point's current value", "group": "look", "time_cost_min": 0, "evidence_type": "bas_value", "effect": "pin_point", "params": {"point": "*"}, "roles": ["technician"]},
    {"action_id": "chiller_panel", "label": "Walk out to the chiller and read its panel", "group": "look", "time_cost_min": 5, "evidence_type": "visual_inspection", "effect": "observe_chiller_panel", "roles": ["technician"]},
    {"action_id": "walk_pumproom", "label": "Walk into the pump room", "group": "look", "time_cost_min": 5, "evidence_type": "visual_inspection", "effect": "observe_pumproom", "roles": ["technician"]},
    {"action_id": "read_suction_gauge", "label": "Read the pump suction pressure gauge", "group": "look", "time_cost_min": 2, "evidence_type": "field_measurement", "effect": "observe_gauge", "roles": ["technician"]},
    {"action_id": "clamp_amps", "label": "Clamp-meter a chilled-water pump motor", "group": "look", "time_cost_min": 5, "evidence_type": "field_measurement", "effect": "observe_amps", "params": {"pump": ["P1", "P2"]}, "hazard_gated": {"param": "pump", "values": ["P1"]}, "roles": ["technician"]},
    {"action_id": "inspect_valve", "label": "Inspect a pump-branch valve body up close", "group": "look", "time_cost_min": 5, "evidence_type": "visual_inspection", "effect": "observe_valve", "params": {"valve": ["P1_TDV", "P2_TDV"]}, "hazard_gated": {"param": "valve", "values": ["P1_TDV"]}, "roles": ["technician"]},
    {"action_id": "check_strainer", "label": "Read the strainer differential pressure", "group": "look", "time_cost_min": 2, "evidence_type": "bas_value", "effect": "observe_strainer", "roles": ["technician"]},
    {"action_id": "check_mau04_travel", "label": "Verify MAU04's chilled-water valve travel at the unit", "group": "look", "time_cost_min": 10, "evidence_type": "field_measurement", "effect": "observe_travel", "roles": ["technician"]},
    {"action_id": "lockout_p1", "label": "De-energize P1 at its breaker and lock it out", "group": "decide", "time_cost_min": 5, "evidence_type": "none", "effect": "lockout_p1", "safety": "requires_decision", "roles": ["technician"]},
    {"action_id": "escalate_hazard", "label": "Report the water hazard to the shift supervisor", "group": "decide", "time_cost_min": 20, "evidence_type": "operator_report", "effect": "escalate_hazard", "safety": "requires_decision", "roles": ["technician"]},
    {"action_id": "energize_p1", "label": "Remove P1's lockout and re-energize it", "group": "decide", "time_cost_min": 5, "evidence_type": "none", "effect": "energize_p1", "safety": "requires_decision", "roles": ["technician"]},
    {"action_id": "isolate_p1_branch", "label": "Close the P1 branch isolation valves", "group": "repair", "time_cost_min": 10, "evidence_type": "none", "effect": "isolate_p1_branch", "hazard_gated": true, "roles": ["technician"]},
    {"action_id": "open_p1_branch", "label": "Open the P1 branch isolation valves", "group": "repair", "time_cost_min": 5, "evidence_type": "none", "effect": "open_p1_branch", "hazard_gated": true, "roles": ["technician"]},
    {"action_id": "replace_p1_valve", "label": "Replace the P1 branch valve body (P1_TDV)", "group": "repair", "time_cost_min": 60, "evidence_type": "none", "effect": "replace_p1_valve", "prerequisites": ["p1_branch_isolated", "p1_deenergized"], "hazard_gated": true, "roles": ["technician"]},
    {"action_id": "open_fill", "label": "Open the makeup (fill) valve", "group": "repair", "time_cost_min": 2, "evidence_type": "none", "effect": "open_fill", "roles": ["technician"]},
    {"action_id": "close_fill", "label": "Close the makeup (fill) valve", "group": "repair", "time_cost_min": 2, "evidence_type": "none", "effect": "close_fill", "roles": ["technician"]},
    {"action_id": "vent_air", "label": "Vent air at the loop high-point vent", "group": "repair", "time_cost_min": 10, "evidence_type": "none", "effect": "vent_air", "roles": ["technician"]},
    {"action_id": "start_p1", "label": "Start pump P1", "group": "control", "time_cost_min": 2, "evidence_type": "none", "effect": "start_pump", "fixed_params": {"pump": "P1"}, "prerequisites": ["p1_energized"], "roles": ["technician"]},
    {"action_id": "stop_p1", "label": "Stop pump P1", "group": "control", "time_cost_min": 2, "evidence_type": "none", "effect": "stop_pump", "fixed_params": {"pump": "P1"}, "roles": ["technician"]},
    {"action_id": "start_p2", "label": "Start pump P2", "group": "control", "time_cost_min": 2, "evidence_type": "none", "effect": "start_pump", "fixed_params": {"pump": "P2"}, "roles": ["technician"]},
    {"action_id": "stop_p2", "label": "Stop pump P2", "group": "control", "time_cost_min": 2, "evidence_type": "none", "effect": "stop_pump", "fixed_params": {"pump": "P2"}, "roles": ["technician"]},
    {"action_id": "reset_chiller", "label": "Press reset at the chiller panel", "group": "control", "time_cost_min": 2, "evidence_type": "none", "effect": "reset_chiller", "roles": ["technician"]}
  ]

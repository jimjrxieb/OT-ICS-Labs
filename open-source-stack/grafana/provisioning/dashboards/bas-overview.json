      "title": "OR Supply Air Temperature (AHU_OR1_SAT)",
      "description": "AHU-OR-1 supply air. Normal: 52-60 °F. Alarm threshold: > 60 °F.",
      "datasource": {"type": "influxdb", "uid": "bas-influxdb"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "°F",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "thresholdsStyle": {"mode": "line+area"}
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "transparent", "value": null},
              {"color": "green", "value": 52},
              {"color": "red", "value": 61}
            ]
          },
          "unit": "fahrenheit",
          "min": 40,
          "max": 80
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "options": {
        "legend": {"calcs": ["last", "min", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "bas-influxdb"},
          "query": "from(bucket: \"bas-trends\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"point_readings\")\n  |> filter(fn: (r) => r.point_name == \"AHU_OR1_SAT\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)",
          "refId": "A"

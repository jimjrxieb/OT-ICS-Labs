[
  {
    "id": "tab-bas-pipeline",
    "type": "tab",
    "label": "BAS Data Pipeline",
    "disabled": false,
    "info": "Subscribes to MQTT BAS point updates published by influx_bridge.py.\nEach message is a JSON payload from bas/points/<point_name>.\n\nTo see live data: start the docker stack, run influx_bridge.py,\nthen run a simulator scenario:\n  python3 simulator/bas_sim.py --scenario chilled_water_degraded --steps 12"
  },
  {
    "id": "config-mqtt-broker",
    "type": "mqtt-broker",
    "name": "Mosquitto (bas-lab)",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "nodered-bas-pipeline",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthRetain": "false",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closeRetain": "false",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willRetain": "false",
    "willPayload": "",
    "willMsg": {},
    "userProps": "",
    "sessionExpiry": ""
  },
  {
    "id": "mqtt-in-all-points",
    "type": "mqtt in",
    "z": "tab-bas-pipeline",
    "name": "All BAS Points",
    "topic": "bas/points/#",
    "qos": "0",
    "datatype": "json",
    "broker": "config-mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 140,
    "y": 120,
    "wires": [["func-annotate-point", "debug-raw-msg"]]
  },
  {
    "id": "func-annotate-point",
    "type": "function",
    "z": "tab-bas-pipeline",
    "name": "Annotate Point",
    "func": "// Extract point_name from MQTT topic: bas/points/CHW_SUPPLY_TEMP\nvar point_name = msg.topic.split('/').pop();\nvar data = msg.payload;\n\n// Add alarm indicator to topic for easy filtering\nmsg.alarm = data.alarm_state === 'ALARM';\nmsg.topic = point_name;\n\n// Status line shown under the node in the editor\nmsg.status = {\n    fill: data.alarm_state === 'ALARM' ? 'red' : 'green',\n    shape: 'dot',\n    text: point_name + ' = ' + data.value + ' [' + data.alarm_state + ']'\n};\n\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 120,
    "wires": [["debug-annotated"]]
  },
  {
    "id": "debug-raw-msg",
    "type": "debug",
    "z": "tab-bas-pipeline",
    "name": "Raw MQTT (off by default)",
    "active": false,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "statusVal": "",
    "statusType": "auto",
    "x": 390,
    "y": 200,
    "wires": []
  },
  {
    "id": "debug-annotated",
    "type": "debug",
    "z": "tab-bas-pipeline",
    "name": "BAS Point (value + alarm)",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload.value",
    "statusType": "msg",
    "x": 590,
    "y": 120,
    "wires": []
  },
  {
    "id": "tab-trigger-scenarios",
    "type": "tab",
    "label": "Trigger Scenarios",
    "disabled": false,
    "info": "Manually trigger BAS simulator scenarios via HTTP POST to the FastAPI\nrunning on the host at http://host.docker.internal:8001.\n\nThe API server must be running:\n  cd slot-3/\n  bash scripts/start-frontend.sh"
  },
  {
    "id": "inject-normal",
    "type": "inject",
    "z": "tab-trigger-scenarios",
    "name": "normal",
    "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": "0.1",
    "topic": "normal",
    "payload": "{}",
    "payloadType": "json",
    "x": 110,
    "y": 120,
    "wires": [["func-build-scenario-url"]]
  },
  {
    "id": "inject-chw-degraded",
    "type": "inject",
    "z": "tab-trigger-scenarios",
    "name": "chilled_water_degraded",
    "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": "0.1",
    "topic": "chilled_water_degraded",
    "payload": "{}",
    "payloadType": "json",
    "x": 150,
    "y": 180,
    "wires": [["func-build-scenario-url"]]
  },
  {
    "id": "inject-iso-loss",
    "type": "inject",
    "z": "tab-trigger-scenarios",
    "name": "isolation_pressure_loss",
    "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": "0.1",
    "topic": "isolation_pressure_loss",
    "payload": "{}",
    "payloadType": "json",
    "x": 150,
    "y": 240,
    "wires": [["func-build-scenario-url"]]
  },
  {
    "id": "inject-or-humidity",
    "type": "inject",
    "z": "tab-trigger-scenarios",
    "name": "or_humidity_excursion",
    "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": "0.1",
    "topic": "or_humidity_excursion",
    "payload": "{}",
    "payloadType": "json",
    "x": 150,
    "y": 300,
    "wires": [["func-build-scenario-url"]]
  },
  {
    "id": "func-build-scenario-url",
    "type": "function",
    "z": "tab-trigger-scenarios",
    "name": "Build POST URL",
    "func": "var scenario = msg.topic;\nmsg.url = 'http://host.docker.internal:8001/api/run/' + scenario;\nmsg.method = 'POST';\nmsg.payload = {};\nnode.status({fill:'blue', shape:'ring', text:'POSTing ' + scenario});\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 210,
    "wires": [["http-post-scenario"]]
  },
  {
    "id": "http-post-scenario",
    "type": "http request",
    "z": "tab-trigger-scenarios",
    "name": "POST /api/run/scenario",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [{"keyType": "other", "keyValue": "Content-Type", "valueType": "other", "valueValue": "application/json"}],
    "x": 580,
    "y": 210,
    "wires": [["debug-scenario-result"]]
  },
  {
    "id": "debug-scenario-result",
    "type": "debug",
    "z": "tab-trigger-scenarios",
    "name": "Scenario Result",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload.scenario",
    "statusType": "msg",
    "x": 780,
    "y": 210,
    "wires": []
  }
]
